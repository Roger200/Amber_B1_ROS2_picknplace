<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>amber_pick_and_place</name>
  <version>0.0.0</version>
  <description>ROS 2 package for pick and place task with Amber robot using MoveIt!</description>
  <maintainer email="user@todo.todo">user</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>moveit_ros_planning_interface</depend> <!-- For MoveGroupInterface -->
  <!-- <depend>moveit_cpp</depend> --> <!-- For MoveItCpp (alternative, more advanced API) - Not used in current node -->
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>gazebo_ros_link_attacher</depend> <!-- For Attach.srv -->
  <depend>moveit_visual_tools</depend> <!-- For Rviz Visual Tools -->
  <depend>moveit_msgs</depend> <!-- For RobotTrajectory, etc. -->


  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
