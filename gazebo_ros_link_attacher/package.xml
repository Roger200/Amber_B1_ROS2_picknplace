<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gazebo_ros_link_attacher</name>
  <version>0.0.0</version>
  <description>Gazebo plugin to attach and detach links via ROS 2 services.</description>
  <maintainer email="user@todo.todo">user</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>gazebo_ros</depend>
  <depend>gazebo_dev</depend> <!-- For Gazebo headers -->
  <depend>geometry_msgs</depend> <!-- For Pose, etc. if needed -->

  <!-- Build dependency for custom service generation -->
  <build_depend>rosidl_default_generators</build_depend>
  <!-- Execution dependency for custom services -->
  <exec_depend>rosidl_default_runtime</exec_depend>
  <!-- Group member for packages that define messages/services -->
  <member_of_group>rosidl_interface_packages</member_of_group>


  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <!-- This line is important for Gazebo to find the plugin -->
    <gazebo_ros gazebo_model_path="${prefix}/../../.." />
    <gazebo_ros gazebo_media_path="${prefix}/../../.." />
  </export>
</package>
