<sdf version='1.7'>
  <model name='realsense_d435'>
    <link name='camera_link'>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <visual name='visual'>
        <geometry>
          <box>
            <size>0.025 0.09 0.025</size> <!-- Approximate dimensions of RealSense D435 -->
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.2 1</diffuse>
          <specular>0 0 0 0</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>
      <collision name='collision'>
        <geometry>
          <box>
            <size>0.025 0.09 0.025</size>
          </box>
        </geometry>
      </collision>
      <sensor name='depth_camera' type='depth'>
        <camera name='realsense_d435_camera_sensor_sdf'> <!-- Unique camera name -->
          <horizontal_fov>1.50098</horizontal_fov> <!-- Approx 86 degrees -->
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>10.0</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <!-- Plugin will be added in the world file -->
      </sensor>
    </link>
  </model>
</sdf>
