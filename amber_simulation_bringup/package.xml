<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>amber_simulation_bringup</name>
  <version>0.0.0</version>
  <description>Main launch package for the Amber arm pick and place simulation.</description>
  <maintainer email="user@todo.todo">user</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend> <!-- Or ament_python if only launch files -->

  <!-- Execution dependencies for launch files -->
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>amber_gazebo</exec_depend>
  <exec_depend>amber_b1_description</exec_depend>
  <exec_depend>amber_arm_moveit_config</exec_depend>
  <exec_depend>cube_perception</exec_depend>
  <exec_depend>amber_pick_and_place</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend> <!-- If not started by MoveIt -->
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>


  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type> <!-- Or ament_python -->
  </export>
</package>
